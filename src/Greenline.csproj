<Project Sdk="Microsoft.NET.Sdk">

  <!-- Build settings and the common game references live in Directory.Build.props at the mod root.
       This file names the plugin and adds the assemblies that only this mod uses. -->
  <PropertyGroup>
    <AssemblyName>Greenline</AssemblyName>
    <Version>1.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\page.js" />
    <EmbeddedResource Include="Web\page\*.js" />
    <EmbeddedResource Include="Web\plantpanel.js" />
    <EmbeddedResource Include="Web\tokens.css" />
    <EmbeddedResource Include="Web\page.css" />
    <EmbeddedResource Include="Web\plantpanel.css" />
  </ItemGroup>

  <!-- The HUD plant list and the planting window are pages of the Vuplex web view. R3 has the
       ReactiveProperty state of the web panels, and ObservableCollections the seed and fertilizer
       lists of the planting window. InputLegacyModule has the pointer place for the world hover card,
       and PhysicsModule the pointer ray hits. -->
  <ItemGroup>
    <_Ref Include="$(BepInExInterop)\Vuplex.WebView.dll" />
    <_Ref Include="$(BepInExInterop)\R3.dll" />
    <_Ref Include="$(BepInExInterop)\ObservableCollections.dll" />
    <_Ref Include="$(BepInExInterop)\UnityEngine.InputLegacyModule.dll" />
    <_Ref Include="$(BepInExInterop)\UnityEngine.PhysicsModule.dll" />
    <Reference Include="@(_Ref)">
      <HintPath>%(FullPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
