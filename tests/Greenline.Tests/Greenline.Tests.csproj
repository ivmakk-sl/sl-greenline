<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Grid\GridLogic.cs" Link="GridLogic.cs" />
    <Compile Include="..\..\src\Hover\HoverLogic.cs" Link="HoverLogic.cs" />
    <Compile Include="..\..\src\Replant\ReplantLogic.cs" Link="ReplantLogic.cs" />
    <Compile Include="..\..\src\Patrol\PatrolLogic.cs" Link="PatrolLogic.cs" />
    <Compile Include="..\..\src\Patrol\RouteLogic.cs" Link="RouteLogic.cs" />
    <Compile Include="..\..\src\Robot\RobotLogic.cs" Link="RobotLogic.cs" />
    <Compile Include="..\..\src\PotOptions\SaveKeyLogic.cs" Link="SaveKeyLogic.cs" />
    <Compile Include="..\..\src\Web\PageJson.cs" Link="PageJson.cs" />
    <Compile Include="..\..\src\Shared\json\cs\*.cs" Link="Shared\json\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Shared\i18n\cs\*.cs" Link="Shared\i18n\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\src\i18n\*.json" LogicalName="Greenline.i18n.%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Web\PageStyle.cs" Link="PageStyle.cs" />
    <None Include="..\fixtures\pots.json" Link="fixtures\pots.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

</Project>
